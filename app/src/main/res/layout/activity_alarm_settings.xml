<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- 页面标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="设置"
            android:textColor="#1976D2"
            android:textSize="22sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"/>

        <!-- ================= 卡片1：自定义闹钟时间 ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义闹钟时间"
                    android:textColor="#1976D2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_alarm_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 根据班组自动设置闹钟，工作日提醒，休息日不提醒\n• 白班和夜班使用不同的闹钟时间\n• 点击时间可以自定义闹钟时间"
                    android:textSize="13sp"
                    android:background="#F0F0F0"
                    android:padding="8dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="6dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="#F7F8FC">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="白班闹钟时间"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="(4:00 - 8:00)"
                            android:gravity="center"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="11sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tv_day_shift_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp"
                            android:gravity="center"
                            android:text="06:00"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="6dp"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="10dp"
                        android:background="#F7F8FC">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="夜班闹钟时间"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:textStyle="bold"/>

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="(16:00 - 20:00)"
                            android:gravity="center"
                            android:textColor="@android:color/darker_gray"
                            android:textSize="11sp"
                            android:layout_marginBottom="2dp"/>

                        <TextView
                            android:id="@+id/tv_night_shift_time"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="4dp"
                            android:gravity="center"
                            android:text="18:00"
                            android:textColor="@color/black"
                            android:textSize="20sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_set_custom_alarm"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置闹钟"
                    android:textSize="14sp"
                    android:backgroundTint="@color/design_default_color_primary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 卡片2：勿扰模式设置 ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:id="@+id/tv_dnd_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="勿扰模式设置"
                    android:textColor="#1976D2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_dnd_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 完全勿扰：指定时段内禁止通知声音\n• 允许重复来电响铃 • 闹钟不受影响\n• 解锁时允许声音提醒"
                    android:textSize="13sp"
                    android:background="#F0F0F0"
                    android:padding="8dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="10dp"/>

                <!-- 白班勿扰时段 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="白班勿扰时段"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_dnd_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="22:00"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#E0E0E0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="至"
                            android:textSize="14sp"
                            android:padding="6dp"/>

                        <TextView
                            android:id="@+id/tv_dnd_end_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="06:00"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#E0E0E0"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- 夜班勿扰时段 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="夜班勿扰时段"
                        android:textColor="@color/black"
                        android:textSize="14sp"
                        android:textStyle="bold"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="4dp">

                        <TextView
                            android:id="@+id/tv_dnd_night_start_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="09:00"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#E0E0E0"/>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="至"
                            android:textSize="14sp"
                            android:padding="6dp"/>

                        <TextView
                            android:id="@+id/tv_dnd_night_end_time"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="18:00"
                            android:textSize="16sp"
                            android:textColor="@color/black"
                            android:gravity="center"
                            android:padding="8dp"
                            android:background="#E0E0E0"/>
                    </LinearLayout>
                </LinearLayout>

                <Button
                    android:id="@+id/btn_set_dnd"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:text="设置勿扰模式"
                    android:textSize="14sp"
                    android:backgroundTint="@color/design_default_color_primary"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- ================= 卡片3：午睡勿扰 ================= -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="午睡勿扰"
                    android:textColor="#1976D2"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp"/>

                <TextView
                    android:id="@+id/tv_nap_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• 设置临时勿扰状态和闹钟\n• 勿扰将在设定时长后自动关闭\n• 适合午休使用"
                    android:textSize="13sp"
                    android:background="#F0F0F0"
                    android:padding="8dp"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="10dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:padding="8dp"
                        android:background="#F7F8FC">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="午睡时长"
                            android:gravity="center"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"/>

                        <TextView
                            android:id="@+id/tv_nap_duration"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="00:35"
                            android:gravity="center"
                            android:textSize="20sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="4dp"
                            android:background="?attr/selectableItemBackground"
                            android:clickable="true"
                            android:focusable="true"/>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btn_set_nap_dnd"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:text="开始午睡"
                        android:textSize="14sp"
                        android:backgroundTint="@color/design_default_color_primary"/>
                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</ScrollView>
